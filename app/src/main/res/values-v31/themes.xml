<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: desfoca o papel de parede atrás do app (efeito vidro fosco). -->
    <style name="Theme.WallCycle" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_tint</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackgroundBlurRadius">48dp</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
